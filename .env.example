# Copy this file to .env and fill in real values. DO NOT commit .env.
# This example must contain placeholders only — never real credentials.

# --- Database ---
DB_HOST=localhost
DB_NAME=xjmu
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4
DB_PORT=3306

# --- Application ---
# Canonical base URL, used to build links in emails (no trailing slash).
APP_URL=http://localhost
# Timezone applied to PHP and the MySQL session.
APP_TIMEZONE=Asia/Shanghai

# --- SMTP (verification / reset / contact emails) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Xinjiang Medical University
SMTP_REPLY_TO=no-reply@example.com
SMTP_TIMEOUT=30
SMTP_DEBUG=0
SMTP_FALLBACK_HOSTS=
# Set to 1 ONLY for a trusted local relay with a self-signed certificate.
SMTP_ALLOW_INSECURE=0
